zoxide-fzf-path() {
local left right
local -a fzf_options=()

left=${LBUFFER}
right=${RBUFFER}

  # Configure fzf options
  fzf_options+=(--ansi --tiebreak=index --height=30%)

  # Run zoxide query and use fzf for fuzzy path matching
  local selected_path
  selected_path=$(zoxide query -l | fzf "${fzf_options[@]}" --header='Select a directory to navigate' --prompt='zoxide-fzf> ')

  # Replace the query with the selected path and check if it's a valid directory
  if [[ -n "$selected_path" ]] && [[ -d "$selected_path" ]]; then
    # Escape special characters and resolve symbolic links and relative path components
    selected_path=$(realpath -- "$selected_path")
    selected_path=$(printf '%q' "$selected_path")
    LBUFFER="$left$selected_path$right"
  else
    echo "Error: '$selected_path' is not a valid directory"
    return 1
  fi
  # Move the cursor to the end of the selected path
  zle end-of-line

  # Refresh the zle line
  zle redisplay
}
zle -N zoxide-fzf-path

