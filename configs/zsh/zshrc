# Swap two files (swap their paths/names): swapfiles a b
swapfiles() {
  emulate -L zsh

  if (( $# != 2 )); then
    print -u2 "usage: swapfiles <path1> <path2>"
    return 2
  fi

  local a=$1
  local b=$2

  if [[ $a == $b ]]; then
    print -u2 "swapfiles: paths are identical"
    return 2
  fi
  if [[ ! -e $a ]]; then
    print -u2 "swapfiles: not found: $a"
    return 1
  fi
  if [[ ! -e $b ]]; then
    print -u2 "swapfiles: not found: $b"
    return 1
  fi

  local tmp="${a:h}/.swapfiles.$$.$RANDOM"
  while [[ -e $tmp ]]; do
    tmp="${a:h}/.swapfiles.$$.$RANDOM"
  done

  command mv -- "$a" "$tmp" || return
  command mv -- "$b" "$a" || { command mv -- "$tmp" "$a"; return 1; }
  command mv -- "$tmp" "$b" || return
}

alias swap=swapfiles
