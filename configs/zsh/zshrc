# Create Claude project memory files and symbolic links
function claude-init() {
    local target_dir="${1:-.}"

    if [[ ! -d "$target_dir" ]]; then
        echo "Error: Directory '$target_dir' does not exist"
        return 1
    fi

    # Create empty CLAUDE.md
    if [[ ! -f "$target_dir/CLAUDE.md" ]]; then
        touch "$target_dir/CLAUDE.md"
        echo "Created empty CLAUDE.md"
    else
        echo "CLAUDE.md already exists"
    fi

    # Create empty CLAUDE.local.md
    if [[ ! -f "$target_dir/CLAUDE.local.md" ]]; then
        touch "$target_dir/CLAUDE.local.md"
        echo "Created empty CLAUDE.local.md"
    else
        echo "CLAUDE.local.md already exists"
    fi

    # Create symbolic link AGENTS.md -> CLAUDE.md
    if [[ ! -L "$target_dir/AGENTS.md" ]]; then
        ln -sf "CLAUDE.md" "$target_dir/AGENTS.md"
        echo "Created symbolic link AGENTS.md -> CLAUDE.md"
    else
        echo "AGENTS.md symbolic link already exists"
    fi

    # Create symbolic link AGENTS.override.md -> CLAUDE.local.md
    if [[ ! -L "$target_dir/AGENTS.override.md" ]]; then
        ln -sf "CLAUDE.local.md" "$target_dir/AGENTS.override.md"
        echo "Created symbolic link AGENTS.override.md -> CLAUDE.local.md"
    else
        echo "AGENTS.override.md symbolic link already exists"
    fi

    # Create local directory if it doesn't exist
    if [[ ! -d "$target_dir/local" ]]; then
        mkdir -p "$target_dir/local"
        echo "Created directory local/"
    else
        echo "local/ directory already exists"
    fi

    # Create empty local/PROD.md
    if [[ ! -f "$target_dir/local/PROD.md" ]]; then
        touch "$target_dir/local/PROD.md"
        echo "Created empty local/PROD.md"
    else
        echo "local/PROD.md already exists"
    fi

    # Create local/docs directory if it doesn't exist
    if [[ ! -d "$target_dir/local/docs" ]]; then
        mkdir -p "$target_dir/local/docs"
        echo "Created directory local/docs/"
    else
        echo "local/docs/ directory already exists"
    fi

    echo "Claude project memory setup complete in: $(realpath "$target_dir")"
}

