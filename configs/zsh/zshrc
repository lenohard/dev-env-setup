_miniaaml_git_branch() {
  command git symbolic-ref --quiet --short HEAD 2>/dev/null || command git rev-parse --short HEAD 2>/dev/null
}

_miniaaml_git_status() {
  command git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return

  local flags=""
  command git diff --no-ext-diff --quiet --ignore-submodules --cached 2>/dev/null || flags+="+"
  command git diff --no-ext-diff --quiet --ignore-submodules 2>/dev/null || flags+="*"
  [[ -n "$(command git ls-files --others --exclude-standard 2>/dev/null)" ]] && flags+="?"

  printf '%s' "$flags"
}

_miniaaml_prompt() {
  local git_branch git_flags

  git_branch=$(_miniaaml_git_branch)
  git_flags=$(_miniaaml_git_status)

  PROMPT='%(?..%F{red}✗ %?%f )%F{blue}%~%f'
  if [[ -n "$git_branch" ]]; then
    PROMPT+=" %F{magenta}git:${git_branch}%f"
    if [[ -n "$git_flags" ]]; then
      PROMPT+=" %F{yellow}[${git_flags}]%f"
    fi
  fi
  PROMPT+=$'\n''%F{green}❯%f '
  RPROMPT=''
}

