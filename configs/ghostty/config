background-opacity = 0.92
# font-family = Maple Mono NF
font-family = Iosevka Nerd Font
# font-family = SFMono Nerd Font 
font-size = 14
theme = Apple System Colors
shell-integration-features = no-cursor,sudo,no-title
cursor-style = block
adjust-cell-height = 35%
# background-opacity = 0.96

mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

window-padding-balance = true 
window-save-state = always
macos-titlebar-style=transparent
window-colorspace = "display-p3"
background = 1C2021
# foreground = d4be98

# keybindings
keybind = cmd+s>r=reload_config
keybind = cmd+s>x=close_surface

keybind = cmd+s>n=new_window

# tabs 
keybind = cmd+s>c=new_tab
keybind = cmd+s>shift+l=next_tab
keybind = cmd+s>shift+h=previous_tab
keybind = cmd+s>comma=move_tab:-1
keybind = cmd+s>period=move_tab:1

# quick tab switch
keybind = cmd+s>1=goto_tab:1
keybind = cmd+s>2=goto_tab:2
keybind = cmd+s>3=goto_tab:3
keybind = cmd+s>4=goto_tab:4
keybind = cmd+s>5=goto_tab:5
keybind = cmd+s>6=goto_tab:6
keybind = cmd+s>7=goto_tab:7
keybind = cmd+s>8=goto_tab:8
keybind = cmd+s>9=goto_tab:9

# split
keybind = cmd+s>\=new_split:right
keybind = cmd+s>-=new_split:down

keybind = cmd+s>j=goto_split:bottom
keybind = cmd+s>k=goto_split:top
keybind = cmd+s>h=goto_split:left
keybind = cmd+s>l=goto_split:right
keybind = cmd+s>x=close_surface

keybind = cmd+s>z=toggle_split_zoom

keybind = cmd+s>e=equalize_splits

# other
copy-on-select = clipboard

# pi image paste workaround (Alt+I sends Ctrl+V character)
keybind = alt+i=text:\x16

# tmux
keybind = cmd+a=text:\x01

keybind = cmd+1=unbind
keybind = cmd+2=unbind
keybind = cmd+3=unbind
keybind = cmd+4=unbind
keybind = cmd+5=unbind
keybind = cmd+6=unbind
keybind = cmd+7=unbind
keybind = cmd+8=unbind
keybind = cmd+9=unbind
keybind = cmd+h=text:\x01h
keybind = cmd+j=text:\x01j
keybind = cmd+k=text:\x01k
keybind = cmd+l=text:\x01l
keybind = cmd+digit1=text:\x011
keybind = cmd+digit2=text:\x012
keybind = cmd+digit3=text:\x013
keybind = cmd+digit4=text:\x014
keybind = cmd+digit5=text:\x015
keybind = cmd+digit6=text:\x016
keybind = cmd+digit7=text:\x017
keybind = cmd+digit8=text:\x018
keybind = cmd+digit9=text:\x019
keybind = cmd+ctrl+-=text:\x01-
keybind = cmd+ctrl+\=text:\x01|
keybind = cmd+ctrl+enter=text:\x01z

#disable original split shortcut
keybind = cmd+d=unbind
keybind = cmd+enter=unbind

# shell intergation
keybind = cmd+s>u=jump_to_prompt:-1
keybind = cmd+s>d=jump_to_prompt:1
keybind = shift+enter=text:\x1b\r
keybind = alt+backspace=text:\x1b\x7f
keybind = shift+enter=text:\n
